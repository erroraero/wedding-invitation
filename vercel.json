{
  "version": 2,
  "name": "ar-wedding",
  "rewrites": [
    {
      "source": "/api/invitation",
      "destination": "/api/invitation.js"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "cleanUrls": true
}
